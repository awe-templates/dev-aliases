#!/usr/bin/env bash
# prx: run a shell command through the reflex proxy, so the command and its
# output land in the reflex history (.reflex/command-executions.json) of the
# repository or workspace you are in. Where no reflex serves the folder, it
# simply runs the command, so prx is safe to use anywhere.
#
#   prx 'git status --short | wc -l'   quote it when it has pipes, && or $
#   prx git log --oneline -3
#
# It is an executable on PATH rather than a shell alias, so it also works in
# scripts, in `zsh -c`, and in AI agent shells that never read ~/.zshrc.
# See reflex-lib.sh for how the reflex CLI is found.
set -u

if [ "$#" -eq 0 ]; then
  echo "usage: prx <command>   (quote it when it has pipes, && or \$)" >&2
  exit 2
fi

cmd="$*"

# shellcheck source=reflex-lib.sh
. "$(dirname "$0")/reflex-lib.sh"

if resolve_reflex; then
  [ -n "$reflex_root" ] && export REFLEX_ROOT="$reflex_root"
  REFLEX_CWD="$PWD" exec node "$reflex_cli" run -- "$cmd"
fi

exec "${SHELL:-/bin/sh}" -c "$cmd"
